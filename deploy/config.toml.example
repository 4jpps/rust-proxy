# Copy to /etc/rust-proxy/config.toml (root:rust-proxy, mode 640 -- if
# you opt to set admin.session_secret/admin_password_hash or
# acme.dns_api_token here instead of via the admin UI, this file holds
# real secrets).
#
# hosts/port_rules below only matter on first boot, to seed an empty
# database -- after that, manage them from the admin UI at
# http://<admin.bind_ip>:<admin.bind_port>/, not by re-editing this file.

[network]
# Optional, empty by default -- unrestricted, bind to whatever address
# this environment actually has (a single IP, a full subnet block,
# several disjoint ranges). Populate this only if you want a bind_ip
# typo caught at config-validation time; can list more than one range.
# bind_ranges = ["10.0.0.0/29"]

[admin]
# bind_ip/bind_port are deliberately omitted here -- they default to
# 0.0.0.0:8084 (see config.rs's AdminConfig), so the admin UI/setup
# wizard is reachable from the network on a genuinely fresh install
# with zero edits to this file. nftables mirrors that: SSH/80/443 are
# always open unconditionally, and the admin port itself is open to
# any source until allowed_ips (below) narrows it down. Override
# bind_ip/bind_port here only if you want something other than "every
# interface, port 8084".
#
# Only these source IPs/CIDRs may reach the admin UI/API -- enforced by
# nftables, not just the application. Empty (the default) means
# unrestricted; set this to your real management network/IP once you
# know it, to actually narrow the admin port down at the firewall
# layer, not just the application layer.
allowed_ips = []
# admin.session_secret/admin_username/admin_password_hash are
# deliberately omitted -- leaving all three unset (never just one or
# two -- config validation rejects a partial set) means the admin UI
# serves a first-launch setup wizard instead, which creates the admin
# account and writes it to the runtime database. Set all three here
# only if you'd rather manage the admin identity as part of this file
# (session_secret: `openssl rand -hex 32`; admin_password_hash:
# `rust-proxy hash-password 'your-real-password'`) -- when set here,
# config.toml always wins over whatever the wizard/DB has, on every
# read.
#
# /etc/rust-proxy is installed read-only (750, root:rust-proxy) to the
# rust-proxy user the daemon runs as -- db_path (and acme's cert_dir/
# account_key_path below) must point somewhere the daemon can actually
# write, hence /var/lib/rust-proxy rather than config.rs's own
# /etc/rust-proxy/... defaults. postinst creates and chowns this
# directory to rust-proxy:rust-proxy for exactly this.
db_path = "/var/lib/rust-proxy/rust-proxy.db"

[acme]
cert_dir = "/var/lib/rust-proxy/certs"
account_key_path = "/var/lib/rust-proxy/acme-account.key"
# contact_email is deliberately omitted here -- same "config.toml is
# only for seeding, the DB-backed value (set from the admin UI's ACME
# settings section, or the setup wizard's optional field) takes over
# from there" precedence the admin identity fields above use. Set it
# here only if you'd rather manage it as part of this file -- when set
# here, config.toml always wins over the admin UI on every read, same
# as the admin identity fields. Left unset everywhere, ACME issuance
# won't work until an operator sets one via the admin UI.
#
# contact_email = "admin@example.com"
# dns_provider/dns_api_token are also deliberately omitted here -- add a
# named DNS-01 credential from the admin UI's "DNS credentials" section
# (or the setup wizard's optional step) instead. Uncomment below only if
# you'd rather seed a single "default" credential from this file at
# first boot (same all-or-nothing precedence as the admin fields above
# doesn't apply here -- this is a single field, either set or not):
#
# dns_provider = "cloudflare"  # also: "digitalocean", "hetzner", "duckdns", "godaddy", "namecheap", "route53"
# dns_api_token = "your-dns-provider-api-token-with-dns-edit-scope"
#
# directory_url defaults to Let's Encrypt production -- point this at
# https://acme-staging-v02.api.letsencrypt.org/directory while testing,
# to avoid production rate limits.
# renew_before_days = 30
#
# organization/organizational_unit are requested in every issued CSR's
# Subject -- but only ever a *request*, not a guarantee: Let's Encrypt
# and virtually every public CA issue Domain Validated certs, which by
# definition can't vouch for organizational identity, so these are
# silently discarded by their CAs. They only actually land in the
# issued certificate against a private/enterprise ACME CA that performs
# real organization vetting (e.g. step-ca configured for OV).
# organization = "Your Company, Inc."
# organizational_unit = "IT Department"

# Example host -- proxies https://app.example.com on 10.0.0.2:443 to a
# local service on 127.0.0.1:8000, with a websocket toggle and an ACME
# cert issued automatically.
# [[hosts]]
# domain = "app.example.com"
# bind_ip = "10.0.0.2"
# bind_port = 443
# upstream = "127.0.0.1:8000"
# upstream_https/upstream_tls_verify/upstream_preserve_host all default
# to false/true/true (plain HTTP upstream, matching the original
# behavior) -- uncomment below if this upstream speaks HTTPS itself
# (its own cert, self-signed or otherwise).
# upstream_https = true
# upstream_tls_verify = false  # accept a self-signed upstream cert; the connection is still encrypted, just not authenticated
# upstream_preserve_host = true  # false rewrites the Host header sent to the upstream to `upstream`'s own host:port instead of the client's original one
# websockets = true
# force_https = true
# acme_enabled = true
# acme_challenge_type defaults to "auto" (http-01 when force_https is
# on, since port 80 is already open; dns-01 otherwise). Set explicitly
# to "http01" or "dns01" to override; wildcard domains always use
# dns-01 regardless of this setting.
# acme_challenge_type = "auto"
# acl_ids selects zero or more named, reusable ACLs (IP-allow and/or
# login gates) by id -- create them from the admin UI's ACLs tab first,
# then list their ids here. Empty/omitted means unrestricted, same as
# leaving a host with no ACLs selected in the UI.
# acl_ids = ["11111111-1111-1111-1111-111111111111"]

# Example redirection host -- old.example.com gets its own ACME cert
# and redirects every request straight to new.example.com, preserving
# whatever path/query was visited. upstream/websockets are ignored when
# redirect is set.
# [[hosts]]
# domain = "old.example.com"
# bind_ip = "10.0.0.2"
# bind_port = 443
# force_https = true
# acme_enabled = true
# [hosts.redirect]
# target = "https://new.example.com"
# preserve_path = true
# status = "permanent"
# enabled = true

# Example port rule -- RustDesk, forwarded from the /29 to a local
# instance. Omit passthrough_target to just open the firewall for a
# service that's already listening locally (e.g. sshd) instead of
# proxying through this daemon.
# [[port_rules]]
# bind_ip = "10.0.0.4"
# port_start = 21115
# port_end = 21119
# protocol = "tcp"
# description = "rustdesk tcp"
# passthrough_target = "127.0.0.1:21115"
# enabled = true
#
# [[port_rules]]
# bind_ip = "10.0.0.4"
# port_start = 21116
# port_end = 21116
# protocol = "udp"
# description = "rustdesk udp"
# passthrough_target = "127.0.0.1:21116"
# enabled = true
