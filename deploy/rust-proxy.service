[Unit]
Description=rust-proxy reverse proxy daemon
After=network.target

[Service]
ExecStart=/usr/bin/rust-proxy --config /etc/rust-proxy/config.toml
Restart=on-failure
User=rust-proxy
Group=rust-proxy
WorkingDirectory=/var/lib/rust-proxy
StateDirectory=rust-proxy
# Auto-creates /var/log/rust-proxy (correct ownership) and grants it
# write access under ProtectSystem=strict below -- no manual
# ReadWritePaths entry needed, same mechanism StateDirectory already
# provides for /var/lib/rust-proxy. Used when admin.log_dir is set to
# this path in config.toml (see config.rs/main.rs); harmless and
# unused otherwise, since log_dir defaults to None (same directory as
# the state DB, the original behavior).
LogsDirectory=rust-proxy

# Runs as a non-root user (created by the packaging postinst, same
# pattern as jpps-store/mlvpn-rs) but still needs to bind privileged
# ports (80/443, and arbitrary passthrough ports like 22) and manage
# nftables -- these two capabilities cover both without running the
# whole process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

# Defense in depth: even with the two capabilities above, deny every
# other avenue root would otherwise have.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/rust-proxy /var/lib/rust-proxy

[Install]
WantedBy=multi-user.target
