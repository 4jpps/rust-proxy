#!/bin/sh
# postinst -- creates the system user and directories, installs a
# working default config.toml on first install if one isn't already
# present, and starts the service. Does NOT collect or generate admin
# credentials / DNS provider config itself anymore -- an unconfigured
# first launch now serves a setup wizard from the admin UI (GET
# /api/setup-status, POST /api/setup; see web/index.html and
# README.md's "First launch" section) instead of this script
# interactively prompting or randomly generating a password.
set -e

CONFIG_DIR=/etc/rust-proxy
CONFIG_FILE=$CONFIG_DIR/config.toml
STATE_DIR=/var/lib/rust-proxy

case "$1" in
configure)
    if ! getent passwd rust-proxy >/dev/null; then
        adduser --system --group --no-create-home --home "$STATE_DIR" rust-proxy
    fi

    mkdir -p "$CONFIG_DIR"
    # Group rust-proxy, not root -- the daemon runs as user rust-proxy
    # (group rust-proxy). Group-writable so the admin UI's System > Server
    # page can save config.toml: it writes a temp file here and renames it
    # over config.toml, keeping config.toml.bak (also why the directory,
    # not just the file, must be writable).
    chown root:rust-proxy "$CONFIG_DIR"
    chmod 770 "$CONFIG_DIR"
    mkdir -p "$STATE_DIR"
    chown rust-proxy:rust-proxy "$STATE_DIR"

    if [ -f "$CONFIG_FILE" ]; then
        # Contents untouched; ownership and mode brought in line so the
        # Server settings page can save it (upgrades from older versions
        # installed it root-owned, 640).
        chown root:rust-proxy "$CONFIG_FILE"
        chmod 660 "$CONFIG_FILE"
        echo "rust-proxy: existing configuration in $CONFIG_FILE left untouched."
    else
        # config.toml.example's [admin]/[acme] sections are safe,
        # working defaults (0.0.0.0:8084, no admin identity or DNS
        # credential set) -- installed verbatim, the daemon starts
        # cleanly and the admin UI serves the first-launch setup
        # wizard, reachable from the network out of the box (not just
        # loopback -- nftables keeps SSH/80/443 open unconditionally,
        # and the admin port open until admin.allowed_ips is set).
        install -m 660 -o root -g rust-proxy /usr/share/doc/rust-proxy/config.toml.example "$CONFIG_FILE"
        echo "rust-proxy: wrote a default $CONFIG_FILE (admin UI on http://<this-host-ip>:8084/)."
        echo "rust-proxy: visit it once to finish setup -- it walks you through creating an admin account."
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
        systemctl enable rust-proxy || true
        # `restart`, not `enable --now` -- starts a stopped unit on a
        # fresh install *and* reloads a running one onto the new
        # binary on an upgrade.
        systemctl restart rust-proxy || true
        # The backup *timer* is enabled+started (it just waits for its
        # next 03:00 firing); the backup *service* itself is a oneshot,
        # never enabled directly -- systemd runs it only when the timer
        # fires. `enable --now` here is correct (unlike rust-proxy.service
        # above) since there's no separate "restart onto new binary"
        # concern for a unit that isn't currently running.
        systemctl enable --now rust-proxy-backup.timer || true
    fi
    ;;
esac

exit 0
